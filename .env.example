AMD_TOKEN_FACTORY_API_KEY=
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_VISION_MODEL=DeepSeek-V4.1-Flash

EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_BASE_URL=https://api.evolus.ai
EVOLUS_AGENT_ID=
EVOLUS_ENABLED=true
EVOLUS_TIMEOUT_SECONDS=120

# Persist LangGraph checkpoints so workflow links and approval interrupts
# survive backend restarts. Set to "memory" only for ephemeral local tests.
FACTORY_WORKFLOW_CHECKPOINTER=postgres
WORKFLOW_ARTIFACT_PERSISTENCE=true



DATABASE_URL=sqlite:///./factory_inspector.db

GOOGLE_CLOUD_VISION_API_KEY=

TAVILY_API_KEY=your_tavily_api_key
# Opt in only when you want confirmed workflows to perform live, bounded
# supplier discovery. It stays off during development and automated tests.
TAVILY_RESEARCH_ENABLED=false
TAVILY_SEARCH_TIMEOUT_SECONDS=8
TAVILY_CACHE_TTL_SECONDS=900

# Optional text-model enrichment for preliminary diagnoses. It can only add
# technician-review hypotheses and cannot authorize repair or replacement.
AMD_REPAIR_DIAGNOSIS_ENABLED=false
